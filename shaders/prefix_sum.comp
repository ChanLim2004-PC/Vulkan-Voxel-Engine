#version 450
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;

struct DrawIndirectCommand {
    uint vertexCount;    
    uint instanceCount; 
    uint firstVertex;    
    uint firstInstance; 
};

struct ChunkMetadata {
    DrawIndirectCommand drawCmd;    
    vec4 aabbMin;
    vec4 aabbMax;
    uint chunkID;
    uint flags;     
    uint _pad[2];
};

layout(buffer_reference, std430) buffer ChunkCountBufferRef {
    ChunkMetadata chunk[];    
};

layout(push_constant) uniform PushConstants {
    ChunkCountBufferRef chunkData;
    uint numDirtyChunks;
    uint _pad;
} push;

shared uint temp[1024];

void main() {
    uint tid = gl_LocalInvocationIndex;

    uint count = 0u;
    if (tid < push.numDirtyChunks) {
        count = push.chunkData.chunk[tid].drawCmd.vertexCount;
    }

    temp[tid] = count;
    barrier();

    for (uint offset = 1u; offset < 1024u; offset <<= 1u) {
        uint val = 0u;
        if (tid >= offset && tid < push.numDirtyChunks) {
            val = temp[tid - offset];
        }
        barrier();
        
        if (tid < push.numDirtyChunks) {
            temp[tid] += val;
        }
        barrier();
    }

    if (tid >= push.numDirtyChunks) {
        return;
    }

    uint startOffset = (tid == 0u) ? 0u : temp[tid - 1];
    
    push.chunkData.chunk[tid].drawCmd.firstVertex = startOffset;
    push.chunkData.chunk[tid].drawCmd.vertexCount = count;
    push.chunkData.chunk[tid].drawCmd.instanceCount = (count > 0u) ? 1u : 0u; 
    push.chunkData.chunk[tid].drawCmd.firstInstance = 0u;
}
