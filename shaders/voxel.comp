#version 450
#extension GL_EXT_buffer_reference : require

struct Vertex {
    vec3 position;
    float uv_x;
    vec3 normal;
    float uv_y;
    vec4 color;
};

struct DrawIndirectCommand {
    uint vertexCount;   
    uint instanceCount; 
    uint firstVertex;   
    uint firstInstance; 
};

struct VkAccelerationStructureBuildRangeInfoKHR {
    uint primitiveCount;
    uint primitiveOffset;
    uint firstVertex;
    uint transformOffset;
};

struct PerlinNoiseData {
    float amplitude;
    float frequency;
    float persistence;
    float lacunarity;
    uint  octave;
};
const PerlinNoiseData noiseData = PerlinNoiseData(300.0f, 0.005f, 0.5f, 2.0f, 7u);

struct ChunkMetadata {
    DrawIndirectCommand drawCmd;    
    vec4 aabbMin;
    vec4 aabbMax;
    uint chunkID;
    uint flags;      
    uint _pad[2];
};

struct MCData { ivec4 triRows[4]; };
struct GRIDCELL { vec3 p[8]; float val[8]; };
struct TRIANGLE { vec3 position[3]; };
struct SingleVoxel { TRIANGLE triangle[5]; uint ntriang; };

layout(buffer_reference, std430) buffer VertexBufferRef {
    Vertex vertices[];
};

layout(buffer_reference, std430) buffer ChunkMetadataBufferRef { 
    ChunkMetadata chunkData[]; 
};

layout(buffer_reference, std430) writeonly buffer RangeBufferRef {
    VkAccelerationStructureBuildRangeInfoKHR ranges[];
};

layout(std140, set = 0, binding = 0) uniform MCUniformBuffer {
    ivec4 edgeTable[64];
    MCData triTable[256];
} u_mcTables;

layout(push_constant) uniform PushConstants {
    VertexBufferRef        outputVertexBuffer;
    ChunkMetadataBufferRef chunkMetadataBuffer;
    RangeBufferRef         rangeBuffer;
    uint                   _pad[2];
    vec4                   inputStartPosition;  
    uvec4                  chunkGridDim;
} push;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

shared uint groupWorkgroupOffset;

int getTriTableValue(uint cubeIndex, int i) {
    if (cubeIndex >= 256u || i < 0 || i >= 16) return -1;
    int row = i / 4;
    int col = i % 4;
    return u_mcTables.triTable[cubeIndex].triRows[row][col];
}

int getEdgeFlags(uint cubeIndex) {
    if (cubeIndex >= 256u) return 0;
    int row = int(cubeIndex) / 4;
    int col = int(cubeIndex) % 4;
    return u_mcTables.edgeTable[row][col];
}

int getTriCount(uint cubeIndex) {
    if (cubeIndex >= 256u) return 0;
    int count = 0;
    for (int i = 0; i < 16; i += 3) {
        if (getTriTableValue(cubeIndex, i) == -1) break;
        count += 3;
    }
    return count;
}

vec2 randomGradiantVector(vec2 gridEdge) {
    gridEdge += 0.01;
    float rx = dot(gridEdge, vec2(123.4, 234.5));
    float ry = dot(gridEdge, vec2(234.5, 345.6));
    return sin(vec2(rx, ry));
}

float perlin_noise(float noiseX, float noiseZ) {
    vec2 p = vec2(noiseX, noiseZ);
    vec2 i = floor(p);
    vec2 f = fract(p);

    vec2 d00 = f - vec2(0.0, 0.0);
    vec2 d10 = f - vec2(1.0, 0.0);
    vec2 d01 = f - vec2(0.0, 1.0);
    vec2 d11 = f - vec2(1.0, 1.0);

    float dot00 = dot(randomGradiantVector(i + vec2(0.0, 0.0)), d00);
    float dot10 = dot(randomGradiantVector(i + vec2(1.0, 0.0)), d10);
    float dot01 = dot(randomGradiantVector(i + vec2(0.0, 1.0)), d01);
    float dot11 = dot(randomGradiantVector(i + vec2(1.0, 1.0)), d11);

    vec2 u = f * f * (vec2(3.0) - 2.0 * f);

    float bottom = mix(dot00, dot10, u.x);
    float top    = mix(dot01, dot11, u.x);
    return mix(bottom, top, u.y);
}

vec3 VertexInterp(float isolevel, vec3 p1, vec3 p2, float valp1, float valp2) {
    if (abs(isolevel - valp1) < 0.00001) return p1;
    if (abs(isolevel - valp2) < 0.00001) return p2;
    float denominator = valp2 - valp1;
    if (abs(denominator) < 0.00001) {
        return (p1 + p2) * 0.5;
    }
    float mu = (isolevel - valp1) / denominator;
    return mix(p1, p2, mu);
}

SingleVoxel marching_cube_calculation(GRIDCELL grid) {
    uint cubeindex = 0u;
    uint ntriang = 0u;
    vec3 vertlist[12];
    float isolevel = 0.0;
    TRIANGLE triangles[5];

    for (int i = 0; i < 8; i++) {
        if (grid.val[i] < isolevel) {
            cubeindex |= (1u << i);
        }
    }
    uint edgeFlags = uint(getEdgeFlags(cubeindex));

    if (edgeFlags == 0u) {
        return SingleVoxel(triangles, 0u);
    }

    if ((edgeFlags & 1u) != 0u)    vertlist[0]  = VertexInterp(isolevel, grid.p[0], grid.p[1], grid.val[0], grid.val[1]);
    if ((edgeFlags & 2u) != 0u)    vertlist[1]  = VertexInterp(isolevel, grid.p[1], grid.p[2], grid.val[1], grid.val[2]);
    if ((edgeFlags & 4u) != 0u)    vertlist[2]  = VertexInterp(isolevel, grid.p[2], grid.p[3], grid.val[2], grid.val[3]);
    if ((edgeFlags & 8u) != 0u)    vertlist[3]  = VertexInterp(isolevel, grid.p[3], grid.p[0], grid.val[3], grid.val[0]);
    if ((edgeFlags & 16u) != 0u)   vertlist[4]  = VertexInterp(isolevel, grid.p[4], grid.p[5], grid.val[4], grid.val[5]);
    if ((edgeFlags & 32u) != 0u)   vertlist[5]  = VertexInterp(isolevel, grid.p[5], grid.p[6], grid.val[5], grid.val[6]);
    if ((edgeFlags & 64u) != 0u)   vertlist[6]  = VertexInterp(isolevel, grid.p[6], grid.p[7], grid.val[6], grid.val[7]);
    if ((edgeFlags & 128u) != 0u)  vertlist[7]  = VertexInterp(isolevel, grid.p[7], grid.p[4], grid.val[7], grid.val[4]);
    if ((edgeFlags & 256u) != 0u)  vertlist[8]  = VertexInterp(isolevel, grid.p[0], grid.p[4], grid.val[0], grid.val[4]);
    if ((edgeFlags & 512u) != 0u)  vertlist[9]  = VertexInterp(isolevel, grid.p[1], grid.p[5], grid.val[1], grid.val[5]);
    if ((edgeFlags & 1024u) != 0u) vertlist[10] = VertexInterp(isolevel, grid.p[2], grid.p[6], grid.val[2], grid.val[6]);
    if ((edgeFlags & 2048u) != 0u) vertlist[11] = VertexInterp(isolevel, grid.p[3], grid.p[7], grid.val[3], grid.val[7]);

    for (int i = 0; i < 16; i += 3) {
        int idx0 = getTriTableValue(cubeindex, i);
        if (idx0 == -1) break;
        int idx1 = getTriTableValue(cubeindex, i + 1);
        int idx2 = getTriTableValue(cubeindex, i + 2);

        if (idx0 >= 0 && idx0 < 12 && idx1 >= 0 && idx1 < 12 && idx2 >= 0 && idx2 < 12) {
            if (ntriang < 5u) {
                triangles[ntriang].position[0] = vertlist[idx0];
                triangles[ntriang].position[1] = vertlist[idx1];
                triangles[ntriang].position[2] = vertlist[idx2];
                ntriang++;
            }
        }
    }
    return SingleVoxel(triangles, ntriang);
}

SingleVoxel evaluate_voxel(vec3 starting_point, vec3 id) {
    float STEP = 1.0f; 
    vec3 UNIT_CUBE_OFFSETS[8] = {
        vec3(0,0,0), vec3(1,0,0), vec3(1,0,1), vec3(0,0,1),
        vec3(0,1,0), vec3(1,1,0), vec3(1,1,1), vec3(0,1,1)
    };

    vec3 cellMinPos = starting_point + (id * STEP);
    GRIDCELL gridcell;
    for (int i = 0; i < 8; i++) {
        gridcell.p[i] = cellMinPos + (UNIT_CUBE_OFFSETS[i] * STEP);
        vec3 pos = gridcell.p[i];
        float total_noise = 0.0;
        float current_amp = noiseData.amplitude;
        float current_freq = noiseData.frequency;

        for (uint j = 0u; j < 7u; j++) {
            float surface = perlin_noise(pos.x * current_freq, pos.z * current_freq);
            total_noise += surface * current_amp;
            current_amp *= noiseData.persistence;
            current_freq *= noiseData.lacunarity;
        }
        gridcell.val[i] = total_noise - pos.y;
    }
    return marching_cube_calculation(gridcell);
}

uint count_single_voxel(vec3 starting_point, vec3 id) {
    float STEP = 1.0f;
    vec3 UNIT_CUBE_OFFSETS[8] = {
        vec3(0,0,0), vec3(1,0,0), vec3(1,0,1), vec3(0,0,1),
        vec3(0,1,0), vec3(1,1,0), vec3(1,1,1), vec3(0,1,1)
    };

    vec3 cellMinPos = starting_point + (id * STEP);
    uint cubeindex = 0u;
    for (int i = 0; i < 8; i++) {
        vec3 pos = cellMinPos + (UNIT_CUBE_OFFSETS[i] * STEP);
        float total_noise = 0.0;
        float current_amp = noiseData.amplitude;
        float current_freq = noiseData.frequency;

        for (uint j = 0u; j < 7u; j++) {
            total_noise += perlin_noise(pos.x * current_freq, pos.z * current_freq) * current_amp;
            current_amp *= noiseData.persistence;
            current_freq *= noiseData.lacunarity;
        }
        if ((total_noise - pos.y) < 0.0) {
            cubeindex |= (1u << i);
        }
    }
    if (getEdgeFlags(cubeindex) == 0) return 0u;
    return uint(getTriCount(cubeindex));
}

ivec3 safeMod3D(ivec3 coord, ivec3 dim) {
    vec3 c = vec3(coord);
    vec3 d = vec3(dim);
    return ivec3(c - d * floor(c / d));
}

void main() {
    uvec3 local_id = gl_LocalInvocationID;
    ivec3 minChunkCoord   = ivec3(floor(push.inputStartPosition.xyz / 32.0));
    ivec3 worldChunkCoord = minChunkCoord + ivec3(gl_WorkGroupID);
    ivec3 slot3D          = safeMod3D(worldChunkCoord, ivec3(push.chunkGridDim.xyz));
    vec3 starting_point   = vec3(worldChunkCoord) * 32.0f;
    uint chunkID = uint(slot3D.x + slot3D.y * int(push.chunkGridDim.x) + slot3D.z * int(push.chunkGridDim.x * push.chunkGridDim.y));

    if ((push.chunkMetadataBuffer.chunkData[chunkID].flags & 2u) == 0u) {
        return;
    }

    uint groupBaseVertexIndex = chunkID * 25000u;
    uint maxChunkVertexLimit  = groupBaseVertexIndex + 25000u;

    // 워크그룹 공유 오프셋 초기화
    if (gl_LocalInvocationIndex == 0u) {
        groupWorkgroupOffset = 0u;
    }
    barrier();

    //  스레드 담당 복셀(4x4x4 = 64개) 삼각형 정점 수 카운트
    uint threadTotalIndices = 0u;
    for (uint x = 0u; x < 4u; x++) {
        for (uint y = 0u; y < 4u; y++) {
            for (uint z = 0u; z < 4u; z++) {
                uvec3 voxel_id = (local_id * 4u) + uvec3(x, y, z);
                threadTotalIndices += count_single_voxel(starting_point, vec3(voxel_id));
            }
        }
    }

    // 원자적으로 워크그룹 내 쓰기 오프셋 예약
    uint myLocalOffset = 0u;
    if (threadTotalIndices > 0u) {
        myLocalOffset = atomicAdd(groupWorkgroupOffset, threadTotalIndices);
    }
    barrier();

    // 실제 정점 생성 및 버퍼 기록
    if (threadTotalIndices > 0u) {
        uint vertexWriteIdx = groupBaseVertexIndex + myLocalOffset;

        for (uint x = 0u; x < 4u; x++) {
            for (uint y = 0u; y < 4u; y++) {
                for (uint z = 0u; z < 4u; z++) {
                    uvec3 voxel_id = (local_id * 4u) + uvec3(x, y, z);
                    SingleVoxel vox = evaluate_voxel(starting_point, vec3(voxel_id));

                    for (uint i = 0u; i < vox.ntriang; i++) {
                        vec3 edgeA = vox.triangle[i].position[1] - vox.triangle[i].position[0];
                        vec3 edgeB = vox.triangle[i].position[2] - vox.triangle[i].position[0];
                        vec3 triNormal = cross(edgeA, edgeB);
                        float len = length(triNormal);
                        triNormal = (len > 1e-5) ? (triNormal / len) : vec3(0.0, 1.0, 0.0);

                        for (uint k = 0u; k < 3u; k++) {
                            if (vertexWriteIdx < maxChunkVertexLimit) {
                                push.outputVertexBuffer.vertices[vertexWriteIdx].position = vox.triangle[i].position[k];
                                push.outputVertexBuffer.vertices[vertexWriteIdx].uv_x     = 0.0;
                                push.outputVertexBuffer.vertices[vertexWriteIdx].normal   = triNormal;
                                push.outputVertexBuffer.vertices[vertexWriteIdx].uv_y     = 0.0;
                                push.outputVertexBuffer.vertices[vertexWriteIdx].color    = vec4(0.8, 0.8, 0.8, 1.0);
                                vertexWriteIdx++;
                            }
                        }
                    }
                }
            }
        }
    }
    barrier();

    // 최종 청크 메타데이터 및 BLAS 인다이렉트 빌드 범위 정보 기록
    if (gl_LocalInvocationIndex == 0u) {
        uint totalVertices = min(groupWorkgroupOffset, 25000u);

        // 그래픽스 간접 드로우 파라미터 갱신
        push.chunkMetadataBuffer.chunkData[chunkID].drawCmd.vertexCount   = totalVertices;
        push.chunkMetadataBuffer.chunkData[chunkID].drawCmd.instanceCount = (totalVertices > 0u) ? 1u : 0u;
        push.chunkMetadataBuffer.chunkData[chunkID].drawCmd.firstVertex   = groupBaseVertexIndex;
        push.chunkMetadataBuffer.chunkData[chunkID].drawCmd.firstInstance = 0u;

        // RT 가속 구조 간접 빌드 파라미터 갱신
        push.rangeBuffer.ranges[chunkID].primitiveCount  = totalVertices / 3u;
        push.rangeBuffer.ranges[chunkID].primitiveOffset = 0u;
        push.rangeBuffer.ranges[chunkID].firstVertex     = 0u;
        push.rangeBuffer.ranges[chunkID].transformOffset = 0u;

        // DIRTY 플래그 클리어
        push.chunkMetadataBuffer.chunkData[chunkID].flags &= ~2u;
    }
}
