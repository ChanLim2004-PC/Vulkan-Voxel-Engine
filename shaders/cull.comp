#version 450
#extension GL_EXT_buffer_reference : require

struct Vertex {
    vec3 position;
    float uv_x;
    vec3 normal;
    float uv_y;
    vec4 color;
};

struct VoxelObject{
    vec3 center;
    float radius;
};

struct DrawIndirectCommands {
    uint vertexCount;   
    uint instanceCount; 
    uint firstVertex;   
    uint firstInstance; 
};

struct ChunkMetadata {
    DrawIndirectCommands drawCmd;    
    vec4 aabbMin;
    vec4 aabbMax;
    //ASBuildRangeInfo blasRange;  
    uint chunkID;
    uint flags;      
    uint _pad[2];
};

layout(buffer_reference, std430) buffer IndirectCommandRef {
    DrawIndirectCommands commands[]; 
};
layout(buffer_reference, std430) buffer ChunkMetaBufferRef{
    ChunkMetadata chunk[]; 
};

layout(buffer_reference, std430) buffer DrawCountBufferRef {
    uint drawcount;
};

layout(push_constant) uniform PushConstants {
    IndirectCommandRef finalIndirectCmdBuffer;
    ChunkMetaBufferRef originalChunkData;
    DrawCountBufferRef drawCounterBuffer;
    uint totalChunkCount;
} push;

layout(std140, set = 0, binding = 0) uniform cullUniformBuffer {
    mat4 view;              
    vec4 frustum;            
    float znear, zfar;           
    uint drawCount;          
    int cullingEnabled;      
    int occlusionEnabled;    
    int lodEnabled;         
    float pyramidWidth;          
    float pyramidHeight;        
}cullData;

// 별도 오프셋 버퍼 없이 ChunkMetadata의 AABB를 활용해 바운딩 구 생성
VoxelObject voxelObjectData(uint gID) {
    VoxelObject obj;
    vec3 minP = push.originalChunkData.chunk[gID].aabbMin.xyz;
    vec3 maxP = push.originalChunkData.chunk[gID].aabbMax.xyz;
    //중심
    obj.center = (minP + maxP) * 0.5f;
    //반지름
    obj.radius = length(maxP - minP) * 0.5f; // 중심에서 모서리까지의 거리
    return obj;
}

bool IsVisible(uint gID){
    VoxelObject voxelObject = voxelObjectData(gID);
    vec3 center = (cullData.view * vec4(voxelObject.center, 1.f)).xyz;
    float radius = voxelObject.radius;
    center.z = -center.z;
    bool visible = true;


    visible = visible && (center.z * cullData.frustum.y - abs(center.x) * cullData.frustum.x > -radius);
    visible = visible && (center.z * cullData.frustum.w - abs(center.y) * cullData.frustum.z > -radius);
    visible = visible && center.z + radius > cullData.znear && center.z - radius < cullData.zfar;
    visible = visible || (cullData.cullingEnabled == 0);

    return visible;
}

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main(){
    uint gID = gl_GlobalInvocationID.x;
    if (gID < push.totalChunkCount) {
	//오리지널
        DrawIndirectCommands originalCmd = push.originalChunkData.chunk[gID].drawCmd;
	//걍 보이는 것만 카트에 담아서 집어넣기
        if (originalCmd.vertexCount > 0u && IsVisible(gID)) {
            // 원자적으로 압축 버퍼의 다음 슬롯 번호 확보
            uint targetIndex = atomicAdd(push.drawCounterBuffer.drawcount, 1u);

            DrawIndirectCommands cmd = originalCmd;
            cmd.instanceCount = 1u;

            // 최종 렌더링용 간접 드로우 버퍼에 패킹
            push.finalIndirectCmdBuffer.commands[targetIndex] = cmd;
        }
    }
}
